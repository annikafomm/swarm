{
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "settings": { "terminal.integrated.defaultProfile.linux": "bash" },
      "extensions": [
        "EditorConfig.EditorConfig",
        "angular.ng-template"
      ]
    }
  },
  "forwardPorts": [4200],
  "portsAttributes": {
    "4200": { "label": "Frontend Development Server" }
  },
  "postCreateCommand": "cd frontend && npm install"
}
