{
  "name": "swarm-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/swarm",
  "remoteUser": "mopitaner",
  "containerEnv": {
    "ALLOWED_ORIGINS": "http://localhost:4200,http://127.0.0.1:4200",
    "UVICORN_RELOAD": "true",
    // Keeps .claude.json inside the state dir below, so one volume covers everything.
    "CLAUDE_CONFIG_DIR": "/home/mopitaner/.claude"
  },
  "mounts": [
    // Claude Code state (session transcripts, credentials, memory) survives rebuilds.
    "source=swarm-claude-state,target=/home/mopitaner/.claude,type=volume"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "git.openRepositoryInParentFolders": "always"
      },
      "extensions": [
        "EditorConfig.EditorConfig",
        "angular.ng-template",
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "forwardPorts": [3000, 4200],
  "portsAttributes": {
    "3000": { "label": "Backend API" },
    "4200": { "label": "Frontend Development Server" },
  },
  "postCreateCommand": "cd /workspaces/swarm/frontend && npm install && cd /workspaces/swarm && git config --global --add safe.directory /workspaces/swarm"
}
