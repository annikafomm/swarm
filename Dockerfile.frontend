# ── Stage 1: Build the Angular application ───────────────────────────────────
FROM node:22-slim AS builder

WORKDIR /app

# Install dependencies first (layer-cached unless package.json changes)
COPY frontend/package*.json ./
RUN npm ci

# Copy the rest of the frontend source and build for production
COPY frontend/ ./
RUN npx ng build --configuration production --base-href /swarm/

# ── Stage 2: Serve compiled app with nginx ───────────────────────────────────
FROM nginx:alpine

# Copy compiled Angular app; fix permissions so nginx (runs as 'nginx', not root)
# can read all files. NFS source files often have rwxrwx--- which blocks reads.
COPY --from=builder /app/dist/frontend/browser /usr/share/nginx/html
RUN chmod -R a+rX /usr/share/nginx/html

# Copy nginx site config (replaces default.conf)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
